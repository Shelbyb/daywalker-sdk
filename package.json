{
  "name": "@shelbyb/daywalker-sdk",
  "version": "0.1.1",
  "description": "Validate Daywalker API tokens and make domain-signed calls to Daywalker Auth from any service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "bin": {
    "daywalker": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelbyb/daywalker-sdk.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15"
  },
  "keywords": [
    "daywalker",
    "api-token",
    "authentication",
    "ed25519",
    "request-signing"
  ],
  "homepage": "https://auth.daywalker.dev/docs",
  "bugs": {
    "url": "https://github.com/Shelbyb/daywalker-sdk/issues"
  }
}
