{
  "name": "@shelbyb/daywalker-sdk",
  "version": "0.18.0",
  "description": "Daywalker Auth service validation plus the DevPulse client SDKs (feature flags, OpenFeature, product analytics, Web Vitals, management API client) in one package with a single runtime dependency (re2js).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "default": "./dist/express.js"
    },
    "./keystore": {
      "types": "./dist/keystore/index.d.ts",
      "import": "./dist/keystore/index.js",
      "default": "./dist/keystore/index.js"
    },
    "./keystore/file": {
      "types": "./dist/keystore/file.d.ts",
      "import": "./dist/keystore/file.js",
      "default": "./dist/keystore/file.js"
    },
    "./flags": {
      "types": "./dist/flags/client.d.ts",
      "import": "./dist/flags/client.js",
      "default": "./dist/flags/client.js"
    },
    "./flags/node": {
      "types": "./dist/flags/node.d.ts",
      "import": "./dist/flags/node.js",
      "default": "./dist/flags/node.js"
    },
    "./flags/react": {
      "types": "./dist/flags/react.d.ts",
      "import": "./dist/flags/react.js",
      "default": "./dist/flags/react.js"
    },
    "./flags/engine": {
      "types": "./dist/flags/engine/index.d.ts",
      "import": "./dist/flags/engine/index.js",
      "default": "./dist/flags/engine/index.js"
    },
    "./openfeature/server": {
      "types": "./dist/openfeature/server.d.ts",
      "import": "./dist/openfeature/server.js",
      "default": "./dist/openfeature/server.js"
    },
    "./openfeature/web": {
      "types": "./dist/openfeature/web.d.ts",
      "import": "./dist/openfeature/web.js",
      "default": "./dist/openfeature/web.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "default": "./dist/analytics/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "default": "./dist/webhooks/index.js"
    },
    "./cron": {
      "types": "./dist/cron/index.d.ts",
      "import": "./dist/cron/index.js",
      "default": "./dist/cron/index.js"
    },
    "./logs": {
      "types": "./dist/logs/index.d.ts",
      "import": "./dist/logs/index.js",
      "default": "./dist/logs/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "import": "./dist/secrets/index.js",
      "default": "./dist/secrets/index.js"
    },
    "./secrets/env": {
      "types": "./dist/secrets/env.d.ts",
      "import": "./dist/secrets/env.js",
      "default": "./dist/secrets/env.js"
    },
    "./oncall": {
      "types": "./dist/oncall/index.d.ts",
      "import": "./dist/oncall/index.js",
      "default": "./dist/oncall/index.js"
    },
    "./slo": {
      "types": "./dist/slo/index.d.ts",
      "import": "./dist/slo/index.js",
      "default": "./dist/slo/index.js"
    },
    "./deploys": {
      "types": "./dist/deploys/index.d.ts",
      "import": "./dist/deploys/index.js",
      "default": "./dist/deploys/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "daywalker": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "!docs/maintenance",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:coverage": "npm run build && node --import tsx --test --experimental-test-coverage --test-coverage-include=src/analytics/web-vitals.ts --test-coverage-include='src/{webhooks,cron,logs,secrets,oncall,slo,deploys,common,license}/**' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 test/*.test.ts",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "npm test",
    "check:examples": "npm run build && tsc -p examples/tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelbyb/daywalker-sdk.git"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "api-token",
    "authentication",
    "daywalker",
    "devpulse",
    "ed25519",
    "feature-flags",
    "openfeature",
    "product-analytics",
    "request-signing",
    "web-vitals",
    "rum",
    "rest-api",
    "webhooks",
    "standard-webhooks",
    "cron-monitoring",
    "logging",
    "secrets",
    "slo",
    "on-call"
  ],
  "homepage": "https://auth.daywalker.dev/docs",
  "bugs": {
    "url": "https://github.com/Shelbyb/daywalker-sdk/issues"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.17.0",
    "@openfeature/web-sdk": "^1.5.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@openfeature/server-sdk": {
      "optional": true
    },
    "@openfeature/web-sdk": {
      "optional": true
    }
  },
  "sideEffects": false,
  "dependencies": {
    "re2js": "2.8.6"
  }
}
